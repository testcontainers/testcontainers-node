{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "workspaces": {
    ".": {
      // Loaded by a <script> tag in docs/site/theme/main.html, not imported by any module.
      "entry": ["docs/site/js/tc-header.js"]
    },
    "packages/testcontainers": {
      // Run by Jest in the Checks workflow via `--testMatch`, which knip can't trace back to a file.
      "entry": ["smoke-test.jest.js"],
      // Docker build contexts that tests copy into images, never imported.
      "ignoreFiles": ["fixtures/**"]
    },
    "packages/modules/chromadb": {
      // chromadb dynamic-imports it as the default embedding function when a collection doesn't set one.
      "ignoreDependencies": ["@chroma-core/default-embed"]
    },
    "packages/modules/gcloud": {
      // firebase-admin/firestore requires it at runtime, but firebase-admin only lists it as optional.
      "ignoreDependencies": ["@google-cloud/firestore"]
    },
    // TODO: remove the three entries below once #1485 declares these dependencies.
    "packages/modules/azurite": {
      "ignoreDependencies": ["@azure/core-auth"]
    },
    "packages/modules/k3s": {
      "ignoreDependencies": ["tar-stream"]
    },
    "packages/modules/selenium": {
      "ignoreDependencies": ["tar-fs", "tmp"]
    }
  }
}
