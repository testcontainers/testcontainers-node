{
  "name": "testcontainers-monorepo",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/testcontainers",
    "packages/modules/*"
  ],
  "scripts": {
    "docs:serve": "docker compose up",
    "test": "vitest run",
    "test:ci": "npm run test -- --coverage",
    "format": "biome format --write .",
    "lint": "biome check --write .",
    "lint:ci": "biome ci package.json \"${WORKSPACE_PATH}\"",
    "update-deps": "npm-check-updates --workspaces --root -u",
    "check-engines:root": "npm exec --yes --package=ls-engines@0.10.1 -- ls-engines --mode ideal --dev --no-current",
    "check-engines:testcontainers": "npm exec --yes --workspace=testcontainers --package=ls-engines@0.10.1 -- ls-engines --mode ideal --no-current",
    "check-compiles": "tsc -b packages/testcontainers packages/modules/*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@vitest/coverage-v8": "^4.1.10",
    "npm-check-updates": "^23.0.0",
    "shx": "^0.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">= 22.22"
  }
}
